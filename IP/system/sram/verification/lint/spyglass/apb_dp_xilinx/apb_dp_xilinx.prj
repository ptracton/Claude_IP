# SpyGlass lint project apb_dp_xilinx: sram_apb_dp, TECH XILINX, all options.
# Written by verification/tools/lint_sram.py (do not edit); run from this
# directory: spyglass_vc -project apb_dp_xilinx.prj -goal lint/lint_rtl -batch -app lint

set_option projectwdir .
set_option enableSV yes
set_option top sram_apb_dp
set_option param {sram_apb_dp.ECC_EN=1 sram_apb_dp.BANK_PG=1 sram_apb_dp.NUM_BANKS=2 sram_apb_dp.BIST_EN=1 sram_apb_dp.READ_LATENCY=2 sram_apb_dp.WIDTH_B=8 sram_apb_dp.COMMON_CLK=0 sram_apb_dp.TECH=1}
# vendor cells: port-only stubs, not linted
set_option stop {xpm_memory_spram xpm_memory_tdpram}
read_file -type verilog { \
