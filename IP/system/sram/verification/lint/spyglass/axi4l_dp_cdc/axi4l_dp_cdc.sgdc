# Clocks and resets of sram_axi4l_dp for SpyGlass CDC (written by lint_sram.py).
# Ports A and B on separate, unrelated clocks (COMMON_CLK = 0); both
# resets synchronous (the IP has no asynchronous reset).
current_design sram_axi4l_dp
clock -name A_ACLK -domain dom_a -period 10
clock -name B_ACLK -domain dom_b -period 13.7
reset -name A_ARESETn -value 0 -sync
reset -name B_ARESETn -value 0 -sync
