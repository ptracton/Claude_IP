# Build artifacts
*.o
*.a
*.so
work-obj*.cf

# Firmware build outputs
firmware/build/
firmware/obj/
firmware/lib/

# Simulation work directories (all simulators; keep the directory itself),
# including code coverage databases and reports (sim_sram.py --coverage)
verification/work/*
!verification/work/.gitkeep
verification/work.vdb/

# Code coverage run by hand (VCS/URG, Xcelium)
*.vdb/
urgReport/
cov_work/
xcelium.d/
xrun.log
xrun.history
xrun.key
waves.shm/
.simvision/
verification/vivado/work/

# Formal verification run directories
verification/formal/work/

# Synthesis intermediates
synthesis/yosys/work/
synthesis/vivado/*.jou
synthesis/vivado/.Xil/
synthesis/vivado/db/
synthesis/vivado/incremental_db/
synthesis/quartus/db/
synthesis/quartus/incremental_db/
synthesis/vivado/work/
synthesis/quartus/work/
# Design Compiler / PrimeTime (csun.edu): netlists, per-netlist reports and
# work directories are regenerated by run_vendor_synth.py --dc and
# run_primetime_sta.py; the summaries (report_<pdk>.txt, report_sta_*.txt)
# are committed
synthesis/designcompiler/netlists/
synthesis/designcompiler/reports/
synthesis/designcompiler/work/
synthesis/primetime/reports/
synthesis/primetime/work/

# VC LP (lp_sram.py): run directories live in verification/work/lp/; the
# results log is verification/lp/lp_results.log (ignored with every *.log)

# Lint logs (regenerated by lint tool)
verification/lint/lint_results.log

# SpyGlass lint / CDC (csun.edu): one directory per configuration written by
# lint_sram.py; keep its project (.prj) and constraints (.sgdc), not the run output
verification/lint/spyglass/*/*
!verification/lint/spyglass/*/*.prj
!verification/lint/spyglass/*/*.sgdc

# Waveform dumps
*.vcd
*.fst
*.ghw
*.vpd
*.fsdb
*.wdb

# Vivado / xsim scratch when a tool is run by hand outside the work directories
*.jou
*.pb
.Xil/
xsim.dir/
webtalk*

# Python cache
__pycache__/
*.pyc
