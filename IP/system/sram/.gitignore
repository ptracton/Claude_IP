# Build artifacts
*.o
*.a
*.so
work-obj*.cf

# Firmware build outputs
firmware/build/
firmware/obj/
firmware/lib/

# Simulation work directories (all simulators; keep the directory itself),
# including code coverage databases and reports (sim_sram.py --coverage)
verification/work/*
!verification/work/.gitkeep
verification/work.vdb/

# Code coverage run by hand (VCS/URG, Xcelium)
*.vdb/
urgReport/
cov_work/
xcelium.d/
xrun.log
xrun.history
xrun.key
waves.shm/
.simvision/
verification/vivado/work/

# Formal verification run directories
verification/formal/work/

# Synthesis intermediates
synthesis/yosys/work/
synthesis/vivado/*.jou
synthesis/vivado/.Xil/
synthesis/vivado/db/
synthesis/vivado/incremental_db/
synthesis/quartus/db/
synthesis/quartus/incremental_db/

# Lint logs (regenerated by lint tool)
verification/lint/lint_results.log

# SpyGlass lint intermediates (csun.edu only — scratch workdir, not results)
verification/lint/spyglass/vcst_rtdb/
verification/lint/spyglass/vcst_rtdb.bak/
verification/lint/spyglass/*.prj.tcl
verification/lint/spyglass/*.prj.tcl.bak
verification/lint/spyglass/vcst_command.log
verification/lint/spyglass/vcst_session.log
verification/lint/spyglass/vcst_session.log.bak
verification/lint/spyglass/.vcstPref
verification/lint/spyglass/spyglass.out
verification/lint/spyglass/report_hdl.txt
verification/lint/spyglass/VCSOptFile.txt

# Waveform dumps
*.vcd
*.fst
*.ghw
*.vpd
*.fsdb

# Python cache
__pycache__/
*.pyc
