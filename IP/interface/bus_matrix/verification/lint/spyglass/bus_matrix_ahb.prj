#SpyGlass project file — bus_matrix_ahb SystemVerilog lint (csun.edu only)
#
# Run via: spyglass_vc -project bus_matrix_ahb.prj -goal lint/lint_rtl -batch -app lint
# (invoked by lint_bus_matrix.py; cwd must be this directory so the relative
# read_file paths below resolve correctly)

set_option projectwdir .
set_option enableSV yes
set_option top bus_matrix_ahb

read_file -type verilog { \
  ../../../design/rtl/verilog/bus_matrix_pkg.sv \
  ../../../design/rtl/verilog/bus_matrix_decoder.sv \
  ../../../design/rtl/verilog/bus_matrix_arb.sv \
  ../../../design/rtl/verilog/bus_matrix_core.sv \
  ../../../design/rtl/verilog/bus_matrix_ahb_tgt.sv \
  ../../../design/rtl/verilog/bus_matrix_ahb_ini.sv \
  ../../../design/rtl/verilog/bus_matrix_ahb.sv \
}
