# synth_bus_matrix_wb_vhdl.ys — Yosys VHDL-2008 synthesis for bus_matrix_wb (Wishbone B4).
# Requires the ghdl plugin (OSS CAD Suite). Run from IP/interface/bus_matrix/:
#   yosys synthesis/yosys/synth_bus_matrix_wb_vhdl.ys

plugin -i ghdl
ghdl --std=08 \
    design/rtl/vhdl/bus_matrix_pkg.vhd \
    design/rtl/vhdl/bus_matrix_decoder.vhd \
    design/rtl/vhdl/bus_matrix_arb.vhd \
    design/rtl/vhdl/bus_matrix_core.vhd \
    design/rtl/vhdl/bus_matrix_wb_tgt.vhd \
    design/rtl/vhdl/bus_matrix_wb_ini.vhd \
    design/rtl/vhdl/bus_matrix_wb.vhd \
    -e bus_matrix_wb

synth -top bus_matrix_wb -flatten
stat
write_verilog -noattr synthesis/yosys/work/bus_matrix_wb_vhdl_synth.v
