# synth_bus_matrix_apb.ys — Yosys SV synthesis for bus_matrix_apb (APB4).
# Default configuration (bus_matrix_pkg). Run from IP/interface/bus_matrix/:
#   yosys synthesis/yosys/synth_bus_matrix_apb.ys

read_verilog -sv \
    design/rtl/verilog/bus_matrix_pkg.sv \
    design/rtl/verilog/bus_matrix_decoder.sv \
    design/rtl/verilog/bus_matrix_arb.sv \
    design/rtl/verilog/bus_matrix_core.sv \
    design/rtl/verilog/bus_matrix_apb_tgt.sv \
    design/rtl/verilog/bus_matrix_apb_ini.sv \
    design/rtl/verilog/bus_matrix_apb.sv

synth -top bus_matrix_apb -flatten
stat
write_verilog -noattr synthesis/yosys/work/bus_matrix_apb_synth.v
