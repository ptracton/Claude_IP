# synth_bus_matrix_axi4l.ys — Yosys SV synthesis for bus_matrix_axi4l (AXI4-Lite).
# Default configuration (bus_matrix_pkg). Run from IP/interface/bus_matrix/:
#   yosys synthesis/yosys/synth_bus_matrix_axi4l.ys

read_verilog -sv \
    design/rtl/verilog/bus_matrix_pkg.sv \
    design/rtl/verilog/bus_matrix_decoder.sv \
    design/rtl/verilog/bus_matrix_arb.sv \
    design/rtl/verilog/bus_matrix_core.sv \
    design/rtl/verilog/bus_matrix_axi4l_tgt.sv \
    design/rtl/verilog/bus_matrix_axi4l_ini.sv \
    design/rtl/verilog/bus_matrix_axi4l.sv

synth -top bus_matrix_axi4l -flatten
stat
write_verilog -noattr synthesis/yosys/work/bus_matrix_axi4l_synth.v
